# =====================================================================
#  SAFETY NET — never commit/upload patient data or derived imaging.
#  This file makes git refuse to track the data, so an accidental
#  `git add .` cannot leak DICOMs or NIfTI outputs to a remote.
# =====================================================================

# Raw DICOM subject folders (one per subject, e.g. CBR-003, CBR-053)
CBR-*/
Patient Files/
*.dcm
DICOMDIR

# All converted / derived imaging output (NIfTI, sidecars, reports).
# The glob also covers timestamped backups like 'BIDS_output.prev-YYYYMMDD-...'.
BIDS_output/
BIDS_output*/
# Curated BIDS-valid dataset built by make_bids.py (patient-derived imaging).
bids/
*.nii
*.nii.gz

# FreeSurfer recon output (patient-derived surfaces/volumes/stats).
freesurfer_subjects/
*.mgz

# Generated deliverables (PDF + handoff zip). Rebuilt by make_report.py / git archive.
deliverable/

# Documents that may contain de-identified-but-sensitive study narrative
*.docx

# Student menu: machine-specific path to the DICOM data folder (no patient
# data, just a local path). Remembered per-computer, not shared.
Pipeline_Alunos/local_dos_dados.txt

# macOS housekeeping
.DS_Store

# Python housekeeping
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
