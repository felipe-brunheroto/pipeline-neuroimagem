# =====================================================================
#  SAFETY NET — never commit/upload patient data or derived imaging.
#  This file makes git refuse to track the data, so an accidental
#  `git add .` cannot leak DICOMs or NIfTI outputs to a remote.
# =====================================================================

# Raw DICOM subject folders (one per subject, e.g. CBR-003, CBR-053)
CBR-*/
Patient Files/
*.dcm
DICOMDIR

# The single BIDS dataset root (patient-derived imaging). This now holds
# EVERYTHING: raw sub-*, the working conversion tree (bids/sourcedata/conversion,
# formerly BIDS_output/), the sourcedata scaffolds, and all derivatives
# (scanner-derived, defaced, FreeSurfer recon). One rule covers it all.
bids/
# Belt-and-braces in case an older run still writes the legacy top-level names.
BIDS_output*/
freesurfer_subjects/
*.nii
*.nii.gz
*.mgz

# Timestamped backups of previous runs (patient-derived; kept on this machine).
archive/

# Generated deliverables (PDF + handoff/export bundles). Rebuilt by the
# make_report.py scripts / export_openneuro.py / git archive.
deliverable/

# Documents that may contain de-identified-but-sensitive study narrative
*.docx

# Student menu: machine-specific path to the DICOM data folder (no patient
# data, just a local path). Remembered per-computer, not shared.
Pipeline_Alunos/local_dos_dados.txt

# macOS housekeeping
.DS_Store

# Python housekeeping
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
